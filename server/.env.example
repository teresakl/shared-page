# 复制成 .env 填自己的值。服务启动时读一次（config.py）。
# 本机可以全空着就跑。只有云端穿透才建议填 CALENDAR_TOKEN。
#
#   cp .env.example .env
#   # 填好之后
#   set -a; source .env; set +a
#   uvicorn web_app:app --host 127.0.0.1 --port 8787


# ============================================================
# 钥匙（可选）
# ============================================================

# 可选。本机 / 局域网不填，打开网页就能用。
# 做云端穿透（frp、Cloudflare Tunnel、公网反代）时建议填一把：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 网页会变成先填钥匙再进月视图；REST 要带 X-Calendar-Token。
CALENDAR_TOKEN=


# ============================================================
# 存储和时区（都有默认值，一般不用改）
# ============================================================

# SQLite 文件放哪。目录不存在会自动建
CALENDAR_DB=./data/calendar.db

# 手机渲染的整页图落在哪，一天一张
CALENDAR_PAGES_DIR=./data/pages

# 全服务一个产品时区。库里存 UTC，所有「哪一天」的判断都换算到这个时区。
# 这是设计决定：这是两个人 + 一个 AI 的日历，不是多时区 SaaS
CALENDAR_TZ=Asia/Shanghai


# ============================================================
# 你们俩的称呼（可选）
# ============================================================

# 不填就是 USER / ASSISTANT 这两个占位符，跟 app 界面上的标签一致。
# ASSISTANT_NAME 是人在手机推送里看到的（「小七贴了一张便签：明天记得吃药」）
# USER_NAME 是 AI 用 see 动作看这一页时读到的
CALENDAR_ASSISTANT_NAME=
CALENDAR_USER_NAME=


# ============================================================
# 每年都过的日子（可选模块 seeder.py）
# ============================================================
#
# 指向一个 JSON 文件，服务启动时把生日、纪念日、节日铺进日历。
# 格式（数组）：[{"month_day": "03-15", "type": "birthday", "title": "生日"}]
# type 可以是 birthday / anniversary / holiday，前端对前两种有专门的画法。
# 重复启动不会写重

CALENDAR_SEED_FILE=
# 往后铺几年
CALENDAR_SEED_YEARS=2
