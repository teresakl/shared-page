# 复制成 .env 填自己的值。服务启动时读一次（config.py）。
# 本机可以全空着就跑。只有云端穿透才建议填 CALENDAR_TOKEN。
#
#   cp .env.example .env
#   # 填好之后
#   set -a; source .env; set +a
#   uvicorn web_app:app --host 127.0.0.1 --port 8787


# ============================================================
# 钥匙（可选）
# ============================================================

# 可选。本机 / 局域网不填，打开网页就能用。
# 做云端穿透（frp、Cloudflare Tunnel、公网反代）时建议填一把：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 网页会变成先填钥匙再进月视图；REST 要带 X-Calendar-Token。
CALENDAR_TOKEN=


# ============================================================
# 存储和时区（都有默认值，一般不用改）
# ============================================================

# SQLite 文件放哪。目录不存在会自动建
CALENDAR_DB=./data/calendar.db

# 手机渲染的整页图落在哪，一天一张
CALENDAR_PAGES_DIR=./data/pages

# 全服务一个产品时区。库里存 UTC，所有「哪一天」的判断都换算到这个时区。
# 这是设计决定：这是两个人 + 一个 AI 的日历，不是多时区 SaaS
CALENDAR_TZ=Asia/Shanghai


# ============================================================
# 你们俩的称呼（可选）
# ============================================================

# 不填就是 USER / ASSISTANT 这两个占位符，跟 app 界面上的标签一致。
# ASSISTANT_NAME 是人在手机推送里看到的（「小七贴了一张便签：明天记得吃药」）
# USER_NAME 是 AI 用 see 动作看这一页时读到的
CALENDAR_ASSISTANT_NAME=
CALENDAR_USER_NAME=


# ============================================================
# 自动抽取（可选模块 extractor.py）
# ============================================================
#
# 把聊天里的一句话喂给 POST /api/v1/calendar/extract，它判断有没有
# 「未来的安排」，有就自己写进日历（第三种笔迹 AUTO）。
# 下面三个缺任何一个，这个模块整个是关的，别的功能一切照常。

# 任何 OpenAI 兼容接口的根，代码会拼 /chat/completions
EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=

# 置信度门槛。模型对「下周三答辩」很确定(0.9)，对「这周末想去逛街」
# 没那么确定(0.6)。低于这个数直接丢。想让它更爱记事就调低
EXTRACTOR_MIN_CONFIDENCE=0.6

# 太短的消息不送模型，省掉「好」「嗯」「在吗」这类调用。
# 默认 4：中文里「周三答辩」四个字就是一件完整的事，设高了会挡掉真安排
EXTRACTOR_MIN_CHARS=4

# 一次模型调用等多久（秒）
EXTRACTOR_TIMEOUT=20

# 自动写入的事件挂在谁名下。只要不是 kitty / master 这两个协议值，
# 前端就会把它画成 AUTO 那种灰色笔迹
CALENDAR_AUTO_ACTOR=auto


# ============================================================
# 每年都过的日子（可选模块 seeder.py）
# ============================================================
#
# 指向一个 JSON 文件，服务启动时把生日、纪念日、节日铺进日历。
# 格式（数组）：[{"month_day": "03-15", "type": "birthday", "title": "生日"}]
# type 可以是 birthday / anniversary / holiday，前端对前两种有专门的画法。
# 重复启动不会写重

CALENDAR_SEED_FILE=
# 往后铺几年
CALENDAR_SEED_YEARS=2


# ============================================================
# 推送（可选模块 push.py）
# ============================================================
#
# 配齐这四个，AI 动日历的时候手机会弹一条原生通知。
# 缺任何一个，登记端点返回 503，其余功能一切照常 —— 只是手机不响。
# 需要一个付费的 Apple 开发者账号来拿 .p8 密钥。
# 同一把 .p8 对 sandbox 和 production 两个环境通用

APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
